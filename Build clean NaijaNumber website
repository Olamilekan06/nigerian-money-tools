<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>NaijaNumber | US & Canada Numbers</title>

  <meta
    name="description"
    content="NaijaNumber provides access to US and Canada phone-number services."
  >

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    header {
      background: #111827;
      color: white;
      padding: 20px;
      text-align: center;
    }

    header h1 {
      margin: 0 0 8px;
      font-size: 28px;
    }

    header p {
      margin: 0;
      color: #d1d5db;
    }

    .hero {
      text-align: center;
      padding: 50px 20px 30px;
    }

    .hero h2 {
      font-size: 32px;
      margin-bottom: 12px;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      line-height: 1.6;
      color: #5b6475;
    }

    .service {
      max-width: 1000px;
      margin: 20px auto 50px;
      padding: 0 20px;
    }

    .service-box {
      background: white;
      border-radius: 16px;
      padding: 25px;
      box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
    }

    .service-box h3 {
      margin-top: 0;
      text-align: center;
      font-size: 22px;
    }

    .notice {
      text-align: center;
      color: #667085;
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 20px;
    }

    #tn-app {
      width: 100%;
      min-height: 200px;
    }

    .info {
      max-width: 1000px;
      margin: 0 auto 40px;
      padding: 0 20px;
    }

    .info-box {
      background: white;
      padding: 25px;
      border-radius: 16px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
    }

    .info-box h3 {
      margin-top: 0;
    }

    .info-box p,
    .info-box li {
      line-height: 1.6;
      color: #5b6475;
    }

    footer {
      background: #111827;
      color: #d1d5db;
      text-align: center;
      padding: 25px 15px;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <!-- PLATFONE WIDGET -->
  <div id="tn-app"></div>

  <script
    src="https://tn.platfone.com/tn.js"
    id="tn-script"
    data-name="NaijaNumber"
    data-logo="https://raw.githubusercontent.com/Olamilekan06/nigerian-money-tools/refs/heads/main/IMG_0619.jpeg"
    data-background-color="#ffffff"
    data-text-color="#14142b"
    data-button-color="#fa8231">
  </script>

  <header>
    <h1>NaijaNumber</h1>
    <p>US & Canada phone-number services</p>
  </header>

  <section class="hero">
    <h2>Get a US or Canada Number</h2>

    <p>
      Choose an available number service through NaijaNumber.
      Follow the instructions shown in the service widget to complete your order.
    </p>
  </section>

  <section class="service">
    <div class="service-box">

      <h3>Available Number Services</h3>

      <p class="notice">
        Services, availability and pricing shown below are provided through
        our number-service provider.
      </p>

    </div>
  </section>

  <section class="info">

    <div class="info-box">

      <h3>How it works</h3>

      <ol>
        <li>Choose an available service.</li>
        <li>Follow the displayed instructions.</li>
        <li>Complete the payment required by the service.</li>
        <li>Use the number only for permitted and legitimate purposes.</li>
      </ol>

      <p>
        Availability, pricing and supported uses can change depending on
        the provider.
      </p>

    </div>

  </section>

  <footer>
    © 2026 NaijaNumber. All rights reserved.
  </footer>

</body>
</html>
